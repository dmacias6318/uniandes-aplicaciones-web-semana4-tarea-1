@model IEnumerable<Provincias.Models.Provincia>

@{
    ViewData["Title"] = "Provincias";
}

<h2>Provincias</h2>

<p>
    <a class="btn btn-success" asp-action="Create">Nueva Provincia</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre de Provincia
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Capital)
            </th>
            <th>
                Extensión
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Numero_Cantones)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Poblacion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Capital)
            </td>
            <td>
                @Html.DisplayFor(model => item.Extension)
            </td>
            <td>
                @Html.DisplayFor(model => item.Numero_Cantones)
            </td>
            <td>
                @Html.DisplayFor(model => item.Poblacion)
            </td>
            <td>
                <a class="btn btn-dark" asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a class="btn btn-warning" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
