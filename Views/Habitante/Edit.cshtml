@model Provincias.Models.Habitante

@{
    ViewData["Title"] = "Editar habitante";
}

<h1>Editar habitante</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Apellido" class="control-label"></label>
                <input asp-for="Apellido" class="form-control" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Fecha_Nacimiento" class="control-label"></label>
                <input asp-for="Fecha_Nacimiento" type="date" class="form-control" />
                <span asp-validation-for="Fecha_Nacimiento" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CorreoElectronico" class="control-label"></label>
                <input asp-for="CorreoElectronico" type="email" class="form-control" />
                <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label for="provinciaId" class="control-label">Provincia</label>
                <select id="provinciaId" name="provinciaId" asp-items="ViewBag.Provincias" class="form-control">
                    <option value="">-- Seleccione una provincia --</option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CantonId" class="control-label"></label>
                <select asp-for="CantonId" asp-items="ViewBag.Cantones" class="form-control" id="CantonId">
                    <option value="">-- Seleccione un cantón --</option>
                </select>
                <span asp-validation-for="CantonId" class="text-danger"></span>
                <span id="cantonError" class="text-danger" role="alert"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const editProvinciaSelect = document.getElementById("provinciaId") as HTMLSelectElement | null;
            const editCantonSelect = document.getElementById("CantonId") as HTMLSelectElement | null;
            const editCantonError = document.getElementById("cantonError");
            if (!editProvinciaSelect || !editCantonSelect || !editCantonError) {
                return;
            }

            editProvinciaSelect.addEventListener("change", async () => {
                editCantonSelect.replaceChildren(new Option("-- Seleccione un cantón --", ""));
                editCantonError.textContent = "";
                if (!editProvinciaSelect.value) {
                    return;
                }

                try {
                    const response = await fetch(`@Url.Action("GetCantones", "Habitante")?provinciaId=${encodeURIComponent(editProvinciaSelect.value)}`);
                    if (!response.ok) {
                        throw new Error("No se pudieron cargar los cantones.");
                    }
                    const editCantones = await response.json() as { id: number; nombre: string }[];
                    editCantones.forEach(editCanton => editCantonSelect.add(new Option(editCanton.nombre, String(editCanton.id))));
                } catch {
                    editCantonError.textContent = "No se pudieron cargar los cantones.";
                }
            });
        })();
    </script>
}
