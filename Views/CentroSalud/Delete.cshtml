@model Provincias.Models.CentroSalud
@{ ViewData["Title"] = "Eliminar centro de salud"; }
<h1>Eliminar centro de salud</h1>
<h3>¿Confirma que desea eliminar este centro?</h3>
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nombre)</dt><dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Tipo)</dt><dd class="col-sm-10">@Model.Tipo</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Telefono)</dt><dd class="col-sm-10">@Model.Telefono</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Direccion)</dt><dd class="col-sm-10">@Model.Direccion</dd>
    <dt class="col-sm-2">Distrito</dt><dd class="col-sm-10">@Model.Distrito.Nombre</dd>
    <dt class="col-sm-2">Cantón</dt><dd class="col-sm-10">@Model.Distrito.Canton.Nombre</dd>
    <dt class="col-sm-2">Provincia</dt><dd class="col-sm-10">@Model.Distrito.Canton.Provincia.Nombre</dd>
</dl>
<form asp-action="Delete"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></form>
